<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- en el móvil: seguir sonando con la pantalla apagada, con el aviso de play y pausa -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- la revisión de vídeos nuevos espera a que haya red (Android lo exige para eso) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- para que la revisión de vídeos nuevos siga tras reiniciar el móvil -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- para pedir la batería "Sin restricciones" (avisos con el móvil en reposo) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- para instalar las versiones nuevas que la app baja de GitHub (Android pide confirmar) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- usesCleartextTraffic: la dirección de casa de Home Assistant suele ser http://192.168…
         (sin https); sin esto Android no la deja usar y siempre se iba por la de fuera -->
    <application
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="Mis Canales"
        android:supportsRtl="true"
        android:theme="@style/Theme.MisCanales"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Compartir un vídeo o un canal desde la app de YouTube del móvil, para añadir su canal -->
            <intent-filter android:label="Añadir a Mis Canales">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Mis Canales Kids: otro icono (y otra tarea en recientes) del mismo programa, siempre en modo niños -->
        <activity
            android:name=".KidsActivity"
            android:banner="@drawable/banner_kids"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_kids"
            android:label="Mis Canales Kids"
            android:taskAffinity="es.miscanales.kids"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Canales M (perfil "montse"): otro icono (morado, y otra tarea en recientes) de la app de los mayores,
             con sus propios canales, vistos y listas (ver Profile) -->
        <activity
            android:name=".MontseActivity"
            android:banner="@drawable/banner_montse"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_montse"
            android:label="Canales M"
            android:taskAffinity="es.miscanales.montse"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Compartir un vídeo desde la app de YouTube, para añadir su canal a Canales M -->
            <intent-filter android:label="Añadir a Canales M">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- El reproductor va en su propia tarea (y uno solo): al minimizarlo a la ventana flotante,
             la app queda debajo para seguir navegando, y al poner otro vídeo se reutiliza. -->
        <activity
            android:name=".PlayerActivity"
            android:autoRemoveFromRecents="true"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:taskAffinity="es.miscanales.player"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode"
            android:exported="false"
            android:screenOrientation="fullSensor" />
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- la alarma de los vídeos nuevos, y volver a ponerla al encender el móvil o actualizar la app -->
        <!-- el botón «Silenciar este canal» de los avisos -->
        <receiver
            android:name=".MuteReceiver"
            android:exported="false" />
        <receiver
            android:name=".NewVideosReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".NewVideosJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- la versión nueva bajada, para el instalador de Android -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

    <!-- Para que Android 11+ deje ver si hay app de YouTube instalada -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:host="www.youtube.com" />
        </intent>
    </queries>
</manifest>
